# ГЕОПУЛЬС — пример конфигурации окружения.
# Скопируйте в .env и заполните значения. Файл .env в git не попадает.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=geopuls
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geopuls

# ── Backend ───────────────────────────────────────────────────────────────────
GEOPULS_ENVIRONMENT=local
GEOPULS_LOG_LEVEL=INFO
GEOPULS_DATABASE_URL=postgresql+asyncpg://geopuls:change-me@localhost:5432/geopuls
GEOPULS_CORS_ORIGINS=["http://localhost:3000"]
GEOPULS_GEOFABRIK_PBF_URL=https://download.geofabrik.de/russia/siberian-fed-district-latest.osm.pbf
GEOPULS_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOPULS_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Коммит сборки — попадает в /version (в CI подставляется автоматически)
GEOPULS_GIT_SHA=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
NEXT_PUBLIC_DATA_VERSION=демо-данные (Этап 0)

# ── Прод (профиль caddy) ──────────────────────────────────────────────────────
# Домен для автоматического TLS; для локального запуска оставьте localhost и не включайте профиль prod
DOMAIN=localhost
