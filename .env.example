# ГЕОПУЛЬС — пример конфигурации окружения.
# Скопируйте в .env и заполните значения. Файл .env в git не попадает.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=geopuls
POSTGRES_PASSWORD=change-me
POSTGRES_DB=geopuls

# ── Backend ───────────────────────────────────────────────────────────────────
GEOPULS_ENVIRONMENT=local
GEOPULS_LOG_LEVEL=INFO
GEOPULS_DATABASE_URL=postgresql+asyncpg://geopuls:change-me@localhost:5432/geopuls
GEOPULS_CORS_ORIGINS=["http://localhost:3000"]
GEOPULS_GEOFABRIK_PBF_URL=https://download.geofabrik.de/russia/siberian-fed-district-latest.osm.pbf
GEOPULS_OVERPASS_URL=https://overpass-api.de/api/interpreter
GEOPULS_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Число классов легенды плотности (0 + N классов). 4 — проверено на данных Томска; 5–6 возможно,
# но на дискретной плотности часть классов получается пустой (ADR 0006).
GEOPULS_LEGEND_CLASSES=4
# Число процессов API (uvicorn --workers). Ответ /api/v1/cells — ~500 КБ GeoJSON, сериализация
# упирается в CPU: на проде переход с 1 на 2 воркера дал двукратное падение p95 этого запроса.
# Ставьте 1, если у машины одно ядро.
GEOPULS_WORKERS=2
# Коммит сборки — попадает в /version (в CI подставляется автоматически)
GEOPULS_GIT_SHA=

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
NEXT_PUBLIC_DATA_VERSION=демо-данные (Этап 0)

# ── Прод (профиль caddy) ──────────────────────────────────────────────────────
# Домен для автоматического TLS. Если домена ещё нет, используйте <IP>.sslip.io: сервис sslip.io
# резолвит такое имя в указанный IP, и Let's Encrypt выдаёт обычный сертификат (проверено на проде).
DOMAIN=localhost

# Поддомен редактора code.<DOMAIN> (code-server на хосте, см. docs/deploy.md). Адрес — шлюз сети
# проекта: редактор слушает его, потому что Caddy живёт в контейнере и loopback хоста ему не виден.
# Точное значение печатает `bash infra/ops/install-code-server.sh`; пример с прода — 172.18.0.1:8080.
# CODE_UPSTREAM=172.18.0.1:8080

# Адрес API для сборки фронтенда. Для прода за Caddy он ОБЯЗАН быть пустым: пустое значение означает
# «тот же origin», и домен не встраивается в сборку (frontend/lib/api.ts). Строку ниже в .env на
# сервере оставляем ровно в таком виде; для локальной работы в контейнерах её нужно убрать целиком,
# иначе фронтенд будет обращаться к same-origin вместо порта API.
# NEXT_PUBLIC_API_BASE_URL=

# Источники CORS (за Caddy не нужны — запросы с того же origin). Меняйте только при выносе API на
# отдельный поддомен: GEOPULS_CORS_ORIGINS=["https://api.geopuls.example.ru"]
# GEOPULS_CORS_ORIGINS=["http://localhost:3000"]

# Вебхук алертов (мониторинг §9.3 и падение обновления §9.2). Поддерживается формат Telegram:
# GEOPULS_ALERT_WEBHOOK=https://api.telegram.org/bot<token>/sendMessage?chat_id=<id>

# ── Cron на сервере (infra/ops/refresh-data.sh) ───────────────────────────────
# Город и выгрузка OSM для планового обновления данных
GEOPULS_CITY=tomsk
GEOPULS_GEOFABRIK_PBF_URL=https://download.geofabrik.de/russia/siberian-fed-district-latest.osm.pbf

# ── Контейнеры (tools/docker-up.ps1) ──────────────────────────────────────────
# Порты, которые публикуются на localhost. CORS API и адрес API для фронтенда следуют за ними.
# Наружу (0.0.0.0) порты не открываются: на проде доступ даёт только Caddy на 80/443.
API_PORT=8000
WEB_PORT=3000
POSTGRES_PORT=5432

