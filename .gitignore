# ── Python (backend, uv) ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
dist/
build/

# ── Node / frontend ──────────────────────────────────────────────────────────
node_modules/
.next/
out/
next-env.d.ts
*.tsbuildinfo
npm-debug.log*
.eslintcache
# воркер MapLibre копируется скриптом scripts/copy-maplibre-worker.mjs при dev/build
frontend/public/maplibre-gl-worker.mjs
frontend/public/maplibre-gl-worker-dev.mjs
frontend/public/maplibre-gl-shared.mjs
frontend/public/maplibre-gl-shared-dev.mjs
# артефакты Playwright
test-results/
playwright-report/
frontend/e2e/screenshots/

# ── Окружение и секреты ──────────────────────────────────────────────────────
.env
.env.*
!.env.example
!**/.env.example

# ── Данные: исходники OSM большие, в git их не храним ────────────────────────
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.osm.pbf
*.osm.bz2
*.osh.pbf
*.gpkg
*.gpkg.zip
*.pmtiles
*.mbtiles

# Исключение: крошечная PBF-фикстура для тестов импортёра (518 байт, генерируется
# помощником backend/tests/fixtures/make_mini_pbf.py)
!backend/tests/fixtures/*.osm.pbf

# ── IDE / OS ─────────────────────────────────────────────────────────────────
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
Thumbs.db
Desktop.ini

# ── Прочее ───────────────────────────────────────────────────────────────────
*.log
tmp/
