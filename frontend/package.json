{
  "name": "geopuls-web",
  "version": "0.1.0",
  "private": true,
  "description": "ГЕОПУЛЬС — тепловая карта плотности организаций (H3 + MapLibre)",
  "scripts": {
    "predev": "node scripts/copy-maplibre-worker.mjs",
