# Caddy как единая точка входа: TLS (Let's Encrypt) + проксирование API и веб-приложения.
# Домен берётся из переменной DOMAIN (см. .env). Для продакшена: DOMAIN=geopuls.example.ru.

{$DOMAIN:localhost} {
	encode zstd gzip

	# API ГЕОПУЛЬС
	handle /api/* {
		reverse_proxy api:8000
	}

	# Служебные эндпоинты — наружу, чтобы работал внешний uptime-мониторинг
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}
	handle /version {
		reverse_proxy api:8000
	}

	# Всё остальное — Next.js
	handle {
		reverse_proxy web:3000
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	log {
		output file /data/access.log {
			roll_size 20MiB
			roll_keep 7
		}
	}
}

# Редактор разработки (code-server) — отдельный поддомен, чтобы не смешивать с приложением.
#
# Редактор слушает только 127.0.0.1:8080 на хосте (см. infra/ops/install-code-server.sh), а Caddy живёт
# в контейнере, поэтому адрес хоста берётся через host.docker.internal (проброшен в docker-compose.yml
# через extra_hosts). Вход — пароль code-server, TLS выпускает Caddy: наружу порт редактора не открыт.
code.{$DOMAIN:localhost} {
	encode zstd gzip
	reverse_proxy host.docker.internal:8080

	header {
		X-Content-Type-Options "nosniff"
		-Server
	}

	log {
		output file /data/code.access.log {
			roll_size 10MiB
			roll_keep 3
		}
	}
}
